{
  "name": "realtime-chat-api",
  "version": "1.0.0",
  "description": "Realtime Chat with Horizontal WebSocket Scaling using Redis Pub/Sub",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "dev:server1": "PORT=3001 SERVER_ID=server-1 ts-node-dev --respawn src/server.ts",
    "dev:server2": "PORT=3002 SERVER_ID=server-2 ts-node-dev --respawn src/server.ts",
    "dev:server3": "PORT=3003 SERVER_ID=server-3 ts-node-dev --respawn src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.6",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
